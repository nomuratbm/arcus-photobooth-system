# =============================================================================
# arcus-photobooth-system — root environment template
# =============================================================================
# Source of truth: shared/contracts.md (section 4) and docs/backend-integration.md
# (section 4). Copy this file into the service/app you are running, or use the
# per-package templates that already exist:
#   - apps/kiosk/.env.example              -> apps/kiosk/.env.local
#   - services/process-photo/.env.example  -> services/process-photo/.env
#
# NEVER put AWS access keys in any .env file that could be committed.
# Locally, use `aws configure` / AWS_PROFILE (default credential chain).
# In AWS, Lambda and the kiosk host should use IAM roles, not static keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared backend variables (contracts.md section 4)
# -----------------------------------------------------------------------------

# S3 photobooth bucket name.
# Used by: process-photo, presign, kiosk server routes (/api/presign, /print)
# Example: arcus-photobooth-storage-dev
BUCKET_NAME=

# DynamoDB sessions table name (partition key: photoId, TTL attribute: ttl).
# Used by: process-photo, ws-connect, ws-disconnect
# Example: arcus-photobooth-sessions-dev
TABLE_NAME=

# API Gateway WebSocket management endpoint (https://, NOT wss://).
# Used by: process-photo (PostToConnection)
# Example: https://{api-id}.execute-api.ap-southeast-1.amazonaws.com/dev
WS_ENDPOINT=

# AWS region where the Bedrock model runs.
# Used by: process-photo. Default: us-east-1
BEDROCK_REGION=us-east-1

# Bedrock model / inference profile ID for background removal.
# Used by: process-photo. Requires model access enabled in BEDROCK_REGION.
BEDROCK_MODEL_ID=us.stability.stable-image-remove-background-v1:0

# Fallback event ID when the session item has no eventId.
# Used by: process-photo. Default: default
DEFAULT_EVENT_ID=default

# CloudFront distribution domain (no https://, no path).
# Used by: kiosk (as NEXT_PUBLIC_CLOUDFRONT_DOMAIN), e2e-runner (CLOUDFRONT_DOMAIN)
# Example: d123456789.cloudfront.net
CLOUDFRONT_DOMAIN=

# -----------------------------------------------------------------------------
# ws-disconnect only (docs/backend-integration.md section 4)
# -----------------------------------------------------------------------------

# Name of the reverse-lookup GSI on the sessions table (partition key: connectionId).
CONNECTION_INDEX_NAME=connectionId-index

# -----------------------------------------------------------------------------
# presign Lambda only
# -----------------------------------------------------------------------------

# Exact kiosk web origin reflected in CORS headers. Optional but recommended.
# Example: http://localhost:3000 for local dev, https://kiosk.arcus.org in prod
ALLOWED_ORIGIN=

# -----------------------------------------------------------------------------
# Kiosk app (apps/kiosk/.env.local) — client-visible values are NEXT_PUBLIC_*
# -----------------------------------------------------------------------------

# WebSocket API base URL; the kiosk appends photoId, eventId, bgId, frameId.
# Example: wss://{api-id}.execute-api.ap-southeast-1.amazonaws.com/dev
NEXT_PUBLIC_WS_URL=

# Same value as CLOUDFRONT_DOMAIN.
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=

# Event folder under assets/frames and assets/backgrounds.
NEXT_PUBLIC_EVENT_ID=default

# Comma-separated ids. The processor loads
# assets/frames/{eventId}/{frameId}.png and
# assets/backgrounds/{eventId}/{bgId}.jpg (or .png for backgrounds).
NEXT_PUBLIC_FRAME_IDS=default
NEXT_PUBLIC_BG_IDS=default

# AWS region used by the kiosk server routes (presign + print listing).
AWS_REGION=ap-southeast-1

# Staff password gating /print. Server-only — never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Live end-to-end test runner (services/presign, `npm run test:e2e`)
# -----------------------------------------------------------------------------

# WS_URL=wss://{api-id}.execute-api.{region}.amazonaws.com/{stage}
# PRESIGN_URL=https://{api-id}.execute-api.{region}.amazonaws.com/{stage}/presign
# CLOUDFRONT_DOMAIN={distribution-id}.cloudfront.net
# TEST_IMAGE_PATH=/path/to/test-subject.jpg
# TEST_TIMEOUT_MS=60000
