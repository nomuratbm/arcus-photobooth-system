# WebSocket API base URL. The kiosk appends photoId, eventId, bgId, and frameId.
# Example: wss://abc123.execute-api.ap-southeast-1.amazonaws.com/dev
NEXT_PUBLIC_WS_URL=

# CloudFront domain only, no https:// and no path.
# Example: d123456789.cloudfront.net
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=

# Event folder under assets/frames and assets/backgrounds.
NEXT_PUBLIC_EVENT_ID=default

# Comma-separated ids. The processor loads
# assets/frames/{eventId}/{frameId}.png and
# assets/backgrounds/{eventId}/{bgId}.jpg
NEXT_PUBLIC_FRAME_IDS=default
NEXT_PUBLIC_BG_IDS=default

# Server-only. Presigns raw uploads and lists final photos.
BUCKET_NAME=
AWS_REGION=ap-southeast-1

# Staff password for /print. Never prefix this with NEXT_PUBLIC_.
ADMIN_PASSWORD=

# AWS credentials come from the default credential chain
# (AWS_PROFILE, or AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY).
# Do not put access keys in this file.
